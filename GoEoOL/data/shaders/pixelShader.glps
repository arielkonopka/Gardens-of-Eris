// Fog of view, fragment part. GLSL ES 1.00 compatible: no loops, no uniform arrays,
// three texture reads and a mix per pixel.
#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif

uniform sampler2D al_tex;      // the scene
uniform sampler2D fogMask;     // how much is seen, painted on the CPU, filtered linearly
uniform sampler2D fogPattern;  // what shows where nothing is seen, tiled over the world
uniform vec4 patternMap;
uniform float minVisibility;
varying vec4 varying_color;
varying vec2 varying_texcoord;
varying vec2 varying_maskcoord;
varying vec2 varying_patterncoord;

void main()
{
    vec4 scene = varying_color * texture2D(al_tex, varying_texcoord);
    float seen = max(minVisibility, texture2D(fogMask, varying_maskcoord).r);
    vec2 tile = fract(varying_patterncoord);
    vec4 fog = texture2D(fogPattern, vec2(tile.x * patternMap.z, (1.0 - tile.y) * patternMap.w));
    gl_FragColor = vec4(mix(fog.rgb, scene.rgb, seen), 1.0);
}
