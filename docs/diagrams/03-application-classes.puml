@startuml
title The program around the world: screens, input, sound, video
skinparam classAttributeIconSize 0
hide empty members

class main <<function>> {
  title loop
  playDemo()
  showEnd()
}
class titleScreen {
  +run() : titleMenu::action
  +showBusy(text)
  +showMessage(headline, lines)
  +showHallOfFame(fame, seconds, highlight)
  +askName(headline, lines, name)
}
class titleMenu {
  screen: MAIN, CONFIG, EDITING, CONTROLS, BINDING
  action: NONE, CONTINUE, START, EXIT, DEMO
  +keyDown(key)
  +command(menuCommand)
  +padButton(button)
  +wait(seconds) : action
  +pressed()
  +setDemoAfter(seconds)
}
class gameSettings <<singleton>> {
  saveDirectory, volumes
  music: samples or performer
  storyScroller, storiesFile
  demoWait, demoLength, hallOfFameLength
  controls
  +load() / save()
}
class "goe::controls::bindings" as bindings {
  +translate(heldState) : controlItem
}
class "goe::controls::menuPad" as menuPad {
  stick deadzone, hold-to-repeat
  +confirmButton(bindings) / backButton(bindings)
  +buttonDown(button) : menuCommand
  +axis(stick, axis, pos) : menuCommand
  +wait(seconds) : menuCommand
}
enum menuCommand {
  none, up, down, left, right
  confirm, back
}
class "goe::controls::editName" as editName <<function>>
class presenter {
  +presentEverything(demo, demoSeconds) : gameEnd
  -showGameField()
  -handleSaveKeys()
  -tickStories()
}
enum gameEnd {
  QUIT
  LOST
  SAVED
  SAVE_FAILED
  DEMO_OVER
  DEMO_DONE
}
class inputManager <<singleton>> {
  input thread
  +getCtrlItem()
  +setControlItem(item)
  +takeExitRequest()
  +activity() : presses
}
class "goe::autopilot" as autopilot {
  +decide(player) : controlItem
}
class "goe::hallOfFame" as hallOfFame {
  top 10: name, score, date
  +load(file) / save(file)
  +qualifies(score)
  +add(entry)
}
class soundManager <<singleton>> {
  +followDifficulty(d) / followSituation(s)
}
class performerStream {
  one OpenAL source, 4 buffers
  +pump(level, situation, gain)
}
class "goe::musician::adaptiveMusician" as musician {
  +setDifficulty / setSituation
  +composeAhead() / renderAudio()
}
class videoManager <<singleton>>
class videoDriver
class configManager <<singleton>> {
  skins.json
}
class fogLayer
class "goe::storyScroller" as storyScroller
class viewPoint <<singleton>>
class "goe::crashLog" as crashLog <<namespace>>

main --> titleScreen
main --> presenter
main ..> hallOfFame
main ..> crashLog
titleScreen --> titleMenu
titleScreen *-- menuPad : pad events
titleScreen ..> editName : name with a pad
menuPad ..> menuCommand
menuPad ..> bindings : Interact = confirm\nDrag / Save and exit = back
titleMenu ..> menuCommand
titleMenu --> gameSettings
gameSettings *-- bindings
inputManager ..> bindings : translate keys and pad
presenter --> inputManager
presenter *-- autopilot : demo
presenter *-- fogLayer
presenter *-- storyScroller
presenter ..> soundManager
soundManager *-- performerStream : when Performer is chosen
performerStream *-- musician
soundManager ..> gameSettings : music source, volume
presenter ..> videoManager
presenter ..> viewPoint
presenter ..> gameEnd
videoManager --> videoDriver
videoDriver ..> configManager
presenter ..> "worldBuilder" : grow / shrink around player
presenter ..> "bElem" : runLiveElements()
@enduml
